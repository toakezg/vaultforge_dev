{
  "transformPreset": "DEFAULT",
  "rules": [
    {
      "matcher": {
        "method": "STARTS_WITH",
        "value": "_",
        "context": "NAME"
      },
      "mode": "DIM",
      "excludes": []
    },
    {
      "matcher": {
        "method": "STARTS_WITH",
        "value": ".",
        "context": "NAME"
      },
      "mode": "DIM",
      "excludes": []
    },
    {
      "matcher": {
        "method": "STARTS_WITH",
        "value": "!",
        "context": "NAME"
      },
      "mode": "HIGHLIGHT",
      "excludes": []
    }
  ],
  "fileOverwrites": {
    "client-pack-readme.txt": "HIGHLIGHT",
    "README.md": "HIGHLIGHT",
    "generated": "HIGHLIGHT",
    "prompt template": "HIGHLIGHT",
    "TASKS.md": "HIGHLIGHT",
    "generated/_gallery": "HIGHLIGHT"
  }
}